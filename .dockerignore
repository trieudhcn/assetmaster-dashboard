secrets/

# Self-hosted runtime data. These directories may contain MySQL socket files
# and must only be bind-mounted at runtime, never copied into a Docker image.
.assetmaster-data/
.assetmaster-files/
backups/

# Local IDE, logs and test artifacts
.vscode/
.idea/
*.log
*.pid
tmp/
temp/
